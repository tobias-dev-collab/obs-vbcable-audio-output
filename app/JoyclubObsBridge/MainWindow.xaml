<Window x:Class="JoyclubObsBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JOYclub OBS Bridge" Icon="{StaticResource BridgeIcon}" Width="920" Height="690" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F7F7FA">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource BridgeIcon}" Width="32" Height="32" Margin="0,0,10,0"/><TextBlock Text="JOYclub OBS Bridge" FontSize="28" FontWeight="SemiBold" Foreground="#24232A" /></StackPanel>
      <TextBlock Text="Lokaler OBS-Status und vorbereitete Streamkonfiguration" Foreground="#625F6B" Margin="0,4,0,0" />
    </StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,10,0">
        <GroupBox Header="OBS Studio">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Adresse" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ObsHost, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" Margin="0,10,0,0"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ObsPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" />
            <TextBlock Grid.Row="2" Text="Passwort" VerticalAlignment="Center" Margin="0,10,0,0"/><PasswordBox x:Name="ObsPassword" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" PasswordChanged="ObsPasswordChanged" />
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="OBS verbinden" Click="ConnectObs_Click"/><TextBlock Text="{Binding ObsStatus}" VerticalAlignment="Center" Foreground="#625F6B" TextWrapping="Wrap" /></StackPanel>
          </Grid>
        </GroupBox>
        <GroupBox Header="Medienübertragung">
          <StackPanel><TextBlock Text="Noch nicht direkt angebunden" FontWeight="SemiBold" Foreground="#A63B00"/>
          <TextBlock Text="OBS Virtual Camera liefert das Bild. Für den gemischten OBS-Ton wird ein vom Nutzer eingerichtetes virtuelles Audiogerät benötigt. Die Auswahl erfolgt später sichtbar in der JOYclub-Seite." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#625F6B"/></StackPanel>
        </GroupBox>
        <GroupBox Header="JOYclub-Sitzung">
          <StackPanel><TextBlock Text="Sichere Browser-Sitzung" FontWeight="SemiBold"/>
          <TextBlock Text="Ohne dokumentierte, autorisierte Publisher-API werden keine Tokens ausgelesen, keine Endpunkte nachgebildet und kein Login automatisiert." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#625F6B"/>
          <Button Content="JOYclub im Browser öffnen" Click="OpenJoyclub_Click" Margin="0,12,0,0" HorizontalAlignment="Left"/></StackPanel>
        </GroupBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,0,0">
        <GroupBox Header="Streamkonfiguration (lokal, noch nicht übertragen)">
          <StackPanel>
            <TextBlock Text="Titel"/><TextBox Text="{Binding StreamTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Beschreibung"/><TextBox Text="{Binding StreamDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <TextBlock Text="Profil"/><ComboBox ItemsSource="{Binding StreamingGenders}" SelectedItem="{Binding SelectedGender}" Margin="0,4,0,10"/>
            <CheckBox Content="Anonym streamen" IsChecked="{Binding IsAnonymous}"/>
            <TextBlock Text="{Binding ConfigurationStatus}" Foreground="#625F6B" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Diagnose (ohne Geheimnisse)">
          <TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="180" Background="White" BorderThickness="0"/>
        </GroupBox>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Text="Phase 1: Direkte Vonage-Übertragung ist ohne offizielle JOYclub-Autorisierung nicht implementiert." Foreground="#625F6B" />
  </Grid>
</Window>
