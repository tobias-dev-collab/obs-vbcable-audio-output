<Window x:Class="JoyclubObsBridge.JoyclubBrowserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="JOYclub – angemeldete Browser-Sitzung" Width="1100" Height="760" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="10"><Button Content="Zur Streaming-Seite" Click="OpenStreamPage_Click" DockPanel.Dock="Left"/><Button Content="Neu laden" Click="Reload_Click" DockPanel.Dock="Left"/><TextBlock Text="Bitte selbst anmelden und alle JOYclub-Berechtigungsabfragen sichtbar bestätigen." VerticalAlignment="Center" Foreground="#625F6B"/></DockPanel>
    <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    <TextBlock Grid.Row="2" Margin="10" Text="Die Bridge liest keine Passwörter, Cookies oder Tokens aus und startet keinen Stream automatisch." Foreground="#625F6B" />
  </Grid>
</Window>
